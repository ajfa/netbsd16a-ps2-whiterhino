From 637b7a9a3a782fc2b6fbb2f62c9298545558f6fe Mon Sep 17 00:00:00 2001
From: ajfa <3520832+ajfa@users.noreply.github.com>
Date: Thu, 1 Oct 2026 21:56:53 -0600
Subject: [PATCH 3/3] loader: fill bootinfo.boot_time from the RTC

bootinfo.boot_time was never filled, so NetBSD/playstation2 read month 0
and complained of a preposterous clock. Read the RTC with sceCdReadClock()
while the CD/NVRAM interface is up and copy it in; sceCdCLOCK and the
bootinfo RTC share the same 8-byte BCD layout.
---
 loader/nvram.c | 21 +++++++++++++++++++++
 loader/nvram.h |  2 ++
 2 files changed, 23 insertions(+)

diff --git a/loader/nvram.c b/loader/nvram.c
index a88e13b..0424da5 100644
--- a/loader/nvram.c
+++ b/loader/nvram.c
@@ -17,6 +17,18 @@ typedef struct {
 	u32 console_type;
 } nvm_offsets_t;
 
+static sceCdCLOCK boot_clock;
+static int boot_clock_valid;
+
+/* sceCdCLOCK and bootinfo's ps2_rtc share one 8-byte BCD layout. */
+int nvram_get_clock(void *rtc8)
+{
+	if (!boot_clock_valid)
+		return -1;
+	memcpy(rtc8, &boot_clock, 8);
+	return 0;
+}
+
 /* NVM offsets. */
 nvm_offsets_t nvmOff[] = {
 	{
@@ -173,6 +185,15 @@ void nvram_init(void)
 			nvm[addr * 2 + 1] = (data >> 8) & 0xFF;
 		}
 	}
+	/* Keep the RTC for bootinfo.boot_time, which was never filled
+	 * (NetBSD/playstation2 reads it and saw month 0: "preposterous clock"). */
+	if (sceCdReadClock(&boot_clock) == 1) {
+		boot_clock.month &= 0x1f;
+		boot_clock_valid = 1;
+		kprintf("RTC 20%02x-%02x-%02x %02x:%02x:%02x (JST)\n", boot_clock.year, boot_clock.month,
+			boot_clock.day, boot_clock.hour, boot_clock.minute, boot_clock.second);
+	}
+
 	rv = sceCdInit(SCECdEXIT);
 	if (rv != 1) {
 		kprintf("Error: sceCdInit(SCECdEXIT) failed\n");
diff --git a/loader/nvram.h b/loader/nvram.h
index 7923ffc..d760007 100644
--- a/loader/nvram.h
+++ b/loader/nvram.h
@@ -22,6 +22,8 @@ const char *getModelFamily(void);
 int isSlimModel(void);
 
 void nvram_init(void);
+/** RTC read during nvram_init(), 8 bytes BCD (bootinfo ps2_rtc layout); -1 if none. */
+int nvram_get_clock(void *rtc8);
 u8 *get_nvram(void);
 extern int nvm_errors;
 
